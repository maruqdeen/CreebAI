# Copy to .env and fill in. .env is gitignored — never commit real values.
# In production these go in Render → Environment, not in a file.
#
# Generate the admin hash and the two secrets with:
#   python -m app.adminpw

# --- Telegram -------------------------------------------------------------
# From BotFather (/newbot). Looks like 1234567890:AAH...
TELEGRAM_BOT_TOKEN=

# Your own Telegram numeric user id, so the bot knows who to escalate to.
# Optional: leave blank and the first person to /start the bot in a DM claims
# the admin seat.
ADMIN_TELEGRAM_USER_ID=

# The group the bot watches. Leave blank to accept whichever group it is
# added to. Group ids are negative, e.g. -1001234567890.
TELEGRAM_GROUP_CHAT_ID=

# --- Groq -----------------------------------------------------------------
# From https://console.groq.com
GROQ_API_KEY=

# openai/gpt-oss-120b and openai/gpt-oss-20b are the only Groq models with
# strict json_schema support, which this pipeline depends on.
# NB: llama-3.3-70b-versatile shut down 2026-08-16 — do not use it.
GROQ_MODEL=openai/gpt-oss-120b

# --- Panel login ----------------------------------------------------------
# Without these nobody can sign in, and the panel is unusable rather than open.
ADMIN_USERNAME=admin
# The scrypt hash from `python -m app.adminpw` — never the password itself.
ADMIN_PASSWORD_HASH=
# Signs session tokens. Changing it signs everyone out, which is how you
# revoke a session.
SECRET_KEY=

# --- Database -------------------------------------------------------------
# SQLite locally. In production, the Neon connection string — a plain
# postgres:// URL is fine, the driver prefix is added automatically.
DATABASE_URL=sqlite:///support.db

# --- Deployment -----------------------------------------------------------
# Leave BLANK locally. Setting it switches the bot from polling to webhooks,
# which is what free hosting needs: an idle instance sleeps and only inbound
# traffic wakes it.
PUBLIC_URL=

# Required whenever PUBLIC_URL is set. Telegram returns it on every delivery,
# so an unsigned POST to the webhook URL is rejected.
TELEGRAM_WEBHOOK_SECRET=

# Where the panel is served from, so the browser is allowed to call this API.
PANEL_BASE_URL=http://localhost:5190
# Any additional origins, comma separated.
EXTRA_CORS_ORIGINS=

# --- App ------------------------------------------------------------------
# PORT is injected by the host and wins over these when present.
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
